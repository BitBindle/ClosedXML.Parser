{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ClosedXML.ANTLR/bin/Debug/net10.0/ClosedXML.ANTLR.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ClosedXML.ANTLR",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Debug ANTLR4 grammar",
            "type": "antlr-debug",
            "request": "launch",
            "input": "${workspaceFolder}/debug-input.txt",
            "grammar": "${workspaceFolder}/ClosedXML.ANTLR/FormulaParser.g4",
            "startRule": "formula",
            "printParseTree": true,
            "visualParseTree": true
        }
    ]
}